{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cadence",
  "version": "0.3.3",
  "identifier": "app.cadence.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Cadence",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 680,
        "center": true,
        "backgroundColor": "#0B0D10"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: https://avatars.githubusercontent.com; connect-src ipc: http://ipc.localhost; frame-src cadence-plugin: http://cadence-plugin.localhost http://localhost:* http://127.0.0.1:*",
      "devCsp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "publisher": "Rémi Lhuillier",
    "homepage": "https://github.com/RemiSDV/cadence",
    "copyright": "© 2026 Rémi Lhuillier",
    "category": "DeveloperTool",
    "shortDescription": "Cockpit de projet logiciel adossé à GitHub",
    "longDescription": "Cadence pilote un projet GitHub version par version (milestones, issues, pull requests, roadmap) avec des agents Claude Code qui proposent pendant que vous disposez.",
    "macOS": {
      "minimumSystemVersion": "10.15",
      "hardenedRuntime": true
    },
    "windows": {
      "nsis": {
        "languages": ["French", "English"]
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDg1OUI2MkNGNENEQTdFMTcKUldRWGZ0cE16MktiaGNGdUtPajUzWXp6aWxZcm1kbENEUGFTT2laMnlpSWo3YjlkVHppelAwbVYK",
      "endpoints": ["https://github.com/RemiSDV/cadence/releases/latest/download/latest.json"],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
